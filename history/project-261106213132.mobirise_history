in=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"content-wrapper\">\n            <div class=\"row align-items-center\">\n                <div class=\"col-12 col-lg-{{imageWidth}}\">\n                    <div class=\"image-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/images-6.webp\" alt=\"Hong Kong Academy For Performing Arts\">\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg\">\n                    <div class=\"text-wrapper\">\n                        <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Hong Kong Academy For Performing Arts</b></h6>\n                        <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b>Unreal Developer</b><br><i>June 2025 - August 2025<br>Full-Time/Contract</i><br><br>Established by government ordinance in 1984, HKAPA is a public higher education institution located in Wan Chai, Hong Kong. It is recognized as a leading tertiary institution for the performing arts in Asia, offering specialized, degree-granting programs in Chinese Opera, Dance, Drama, Film and Television, Music, and Theatre and Entertainment Arts.<br><br><b>Contributions</b><br>• Enhanced cineDESK, a proprietary UE5 cinematic tool, by developing intuitive UMG/Slate UI panels for timeline editing, camera sequencing, and real-time preview.\n<br>• Optimized widget rendering and data-binding logic to improve edi