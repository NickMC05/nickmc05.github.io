          "_name": "content7",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content7\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <input type=\"color\" name=\"lineColor\" title=\"Line Color\" value=\"#6592e6\">\n        <input type=\"color\" name=\"cardColor\" title=\"Color\" value=\"#fafafa\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <blockquote>\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Example Schedule Data</b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">type ResponseTemplate = {\n<br>&nbsp; &nbsp; TopicName: string,\n<br>&nbsp; &nbsp; RequiredWords: {string},\n<br>&nbsp; &nbsp; UserInputKeywords: {string},\n<br>&nbsp; &nbsp; StandardResponses: {string},\n<br>&nbsp; &nbsp; RepeatedResponses: {string}\n<br>}\n<br>\n<br>local function evaluateBestResponse(tokens: TokenArray, database: {ResponseTemplate}): ResponseTemplate?\n<br>&nbsp; &nbsp; local bestScore: number = 0\n<br>&nbsp; &nbsp; local bestTemplate: ResponseTemplate? = nil\n<br>\n<br>&nbsp; &nbsp; for _, template in ipairs(database) do\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- OPTIMIZATION: Early exit. If required words aren't present, skip scoring entirely.\n<br>&nbsp; &nbsp; &nbsp; &nbsp; local hasAllRequired: boolean = true\n<br>&nbsp; &nbsp; &nbsp; &nbsp; for _, reqWord in ipairs(template.RequiredWords) do\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if not table.find(tokens, reqWord) then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; hasAllRequired = false\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; break\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; end\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; if hasAllRequired then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; local currentScore: number = 0\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; -- Score based on additional keyword density<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; for _, token in ipairs(tokens) do\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if table.find(template.UserInputKeywords, token) then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; currentScore += 1\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; end\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; end\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; -- Update best match if this template scored higher\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if currentScore &gt; bestScore then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; bestScore = currentScore\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; bestTemplate = template\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; end\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end\n<br>&nbsp; &nbsp; end\n<br>\n<br>&nbsp; &nbsp; -- Returns nil if no template scored &gt; 0, triggering a fallback response\n<br>&nbsp; &nbsp; return bestTemplate\n<br>end</p></blockquote>\n            </div>\n        </div>\n    </div>\n</section>",
