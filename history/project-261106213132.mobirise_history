          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content7\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <input type=\"color\" name=\"lineColor\" title=\"Line Color\" value=\"#6592e6\">\n        <input type=\"color\" name=\"cardColor\" title=\"Color\" value=\"#fafafa\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <blockquote>\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Example Schedule Data</b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">local ChatService = game:GetService(\"Chat\")\n<br>\n<br>game.Players.PlayerAdded:Connect(function(player: Player)\n<br>&nbsp; &nbsp; player.Chatted:Connect(function(rawMessage: string)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- 1. Sanitize\n<br>&nbsp; &nbsp; &nbsp; &nbsp; local tokens = sanitizeAndTokenize(rawMessage)\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- 2. Check for Dynamic Modes first (e.g., Math, Commands)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; local modeResponse = handleDynamicModes(tokens, rawMessage)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; if modeResponse then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ChatService:Chat(player.Character.Head, modeResponse, Enum.ChatColor.Blue)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- 3. Heuristic Scoring\n<br>&nbsp; &nbsp; &nbsp; &nbsp; local bestMatch = evaluateBestResponse(tokens, ResponseDatabase)\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- 4. Generate Reply (or fallback)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; local finalReply: string\n<br>&nbsp; &nbsp; &nbsp; &nbsp; if bestMatch then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; finalReply = processConversationState(bestMatch, player)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; else\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; finalReply = FallbackDatabase[math.random(1, #FallbackDatabase)]\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; SessionState.CurrentTopic = \"Idle\" -- Reset on misunderstanding\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- 5. Output to player\n<br>&nbsp; &nbsp; &nbsp; &nbsp; if finalReply ~= \"\" then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ChatService:Chat(player.Character.Head, finalReply, Enum.ChatColor.Blue)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end\n<br>&nbsp; &nbsp; end)\n<br>end)</p></blockquote>\n            </div>\n        </div>\n    </div>\n</section>",
