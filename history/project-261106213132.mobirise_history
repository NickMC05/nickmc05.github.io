          "_name": "content7",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content7\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <input type=\"color\" name=\"lineColor\" title=\"Line Color\" value=\"#6592e6\">\n        <input type=\"color\" name=\"cardColor\" title=\"Color\" value=\"#fafafa\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <blockquote>\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Example Schedule Data</b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">local function handleDynamicModes(tokens: TokenArray, rawInput: string): string?\n<br>&nbsp; &nbsp; -- Detect if input is purely a math equation (contains digits AND operators)\n<br>&nbsp; &nbsp; local hasNumber: boolean = string.match(rawInput, \"%d\") ~= nil\n<br>&nbsp; &nbsp; local hasOperator: boolean = string.match(rawInput, \"[%+%-%*%/%%]\") ~= nil\n<br>\n<br>&nbsp; &nbsp; if hasNumber and hasOperator and SessionState.CurrentTopic == \"Idle\" then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; SessionState.CurrentTopic = \"MathMode\" -- Lock state\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- Sanitize strictly to only allow math characters before evaluation\n<br>&nbsp; &nbsp; &nbsp; &nbsp; local safeEquation: string = string.gsub(rawInput, \"[^%d%+%-%*%/%%%.%s]\", \"\")\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- SAFE EXECUTION: Wrap dynamic code evaluation in pcall (protected call)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; local success: boolean, result: any = pcall(function()\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; local evalFunc = loadstring(\"return \" .. safeEquation)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return evalFunc and evalFunc() or \"Invalid Expression\"\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end)\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; SessionState.CurrentTopic = \"Idle\" -- Unlock state\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; if success and type(result) == \"number\" then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return `The calculated result is: {result}`\n<br>&nbsp; &nbsp; &nbsp; &nbsp; else\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return \"I encountered an error computing that equation.\"\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end\n<br>&nbsp; &nbsp; end\n<br>\n<br>&nbsp; &nbsp; return nil -- Fall back to standard heuristic scoring\n<br>end</p></blockquote>\n            </div>\n        </div>\n    </div>\n</section>",
