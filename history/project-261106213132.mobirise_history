          "_name": "content7",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content7\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <input type=\"color\" name=\"lineColor\" title=\"Line Color\" value=\"#6592e6\">\n        <input type=\"color\" name=\"cardColor\" title=\"Color\" value=\"#fafafa\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <blockquote>\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Example Schedule Data</b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\">local SessionState = {\n<br>&nbsp; &nbsp; CurrentTopic = \"Idle\",\n<br>&nbsp; &nbsp; RepetitionCount = 0,\n<br>&nbsp; &nbsp; Sentiment = { Anger = 0, Friendship = 0 }\n<br>}\n<br>\n<br>local THRESHOLDS = {\n<br>&nbsp; &nbsp; WARNING = 3,\n<br>&nbsp; &nbsp; KICK = 5\n<br>}\n<br>\n<br>local function processConversationState(selectedTemplate: ResponseTemplate, player: Player): string\n<br>&nbsp; &nbsp; local newTopic = selectedTemplate.TopicName\n<br>\n<br>&nbsp; &nbsp; if SessionState.CurrentTopic == newTopic then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; SessionState.RepetitionCount += 1\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- Defensive: Prevent infinite loops or database spam\n<br>&nbsp; &nbsp; &nbsp; &nbsp; if SessionState.RepetitionCount &gt;= THRESHOLDS.KICK then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; warn(`[Security] Spam detected from {player.Name}. Terminating session.`)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; player:Kick(\"Excessive conversational repetition detected.\")\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return \"\"\n<br>&nbsp; &nbsp; &nbsp; &nbsp; elseif SessionState.RepetitionCount &gt;= THRESHOLDS.WARNING then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; -- Provide a specialized \"stop spamming\" response\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return selectedTemplate.RepeatedResponses[math.random(1, #selectedTemplate.RepeatedResponses)]\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end\n<br>&nbsp; &nbsp; else\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- Topic Shift: Reset counters and update context\n<br>&nbsp; &nbsp; &nbsp; &nbsp; SessionState.CurrentTopic = newTopic\n<br>&nbsp; &nbsp; &nbsp; &nbsp; SessionState.RepetitionCount = 1\n<br>\n<br>&nbsp; &nbsp; &nbsp; &nbsp; -- Example of sentiment tracking affecting state\n<br>&nbsp; &nbsp; &nbsp; &nbsp; if newTopic == \"Compliment\" then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; SessionState.Sentiment.Friendship += 1\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; SessionState.Sentiment.Anger = math.clamp(SessionState.Sentiment.Anger - 1, 0, 10)\n<br>&nbsp; &nbsp; &nbsp; &nbsp; elseif newTopic == \"Insult\" then\n<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; SessionState.Sentiment.Anger += 1\n<br>&nbsp; &nbsp; &nbsp; &nbsp; end\n<br>&nbsp; &nbsp; end\n<br>\n<br>&nbsp; &nbsp; -- Return a standard randomized response from the matched topic\n<br>&nbsp; &nbsp; return selectedTemplate.StandardResponses[math.random(1, #selectedTemplate.StandardResponses)]\n<br>end</p></blockquote>\n            </div>\n        </div>\n    </div>\n</section>",
